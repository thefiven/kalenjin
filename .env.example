# Copy this file to .env and fill in real values. Never commit .env.

# Garmin Connect credentials, used by python-garminconnect (v0.3.5+) to authenticate.
# garth is deprecated and must not be used directly — see CONTEXT.md.
GARMIN_EMAIL=
GARMIN_PASSWORD=

# Gemini API key (free tier) — see ADR-0002. All LLM calls must go through the
# abstraction layer, never call the SDK directly with this key scattered across the code.
GEMINI_API_KEY=

# PostgreSQL connection string — see ADR-0004.
DATABASE_URL=postgresql://user:password@localhost:5432/kalenjin

# Encryption key for per-user secrets at rest (ADR-0010). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=

# Google OAuth (ADR-0008). Create an OAuth client at
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback
SESSION_SECRET_KEY=
FRONTEND_BASE_URL=http://localhost:3000
